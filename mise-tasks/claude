#!/bin/bash
#MISE description="動いている VM の中で claude を開く。ID で会話を再開し、--repo で新しい作業を始める（mise run start の間だけ）。claude の引数は -- のあとに書く"
set -euo pipefail

ROOT="${MISE_PROJECT_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}"
# shellcheck source=../config.sh
. "$ROOT/config.sh"
# shellcheck source=../lib/vm.sh
. "$ROOT/lib/vm.sh"

VM="${AAV_VM:-$VM_NAME}"
ID=""
NAME=""
PASS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --) shift; PASS=("$@"); break ;;
    --repo) [ $# -ge 2 ] || die "--repo にリポジトリ名を渡してください"; NAME=$2; shift 2 ;;
    --repo=*) NAME=${1#--repo=}; shift ;;
    # mise が最初の -- を取り除くので、知らない -x が出たら、そこから後ろは全部 claude に渡す
    -*) PASS=("$@"); break ;;
    *) [ -z "$ID" ] || die "会話の ID は 1 つだけ渡してください"; ID=$1; shift ;;
  esac
done
[ -z "$ID" ] || [ -z "$NAME" ] || die "ID と --repo は同時に渡せません"

# 共有フォルダの env.sh を読むところまでは、どの使い方でも同じ。
# claude の既定の引数（config.sh の CLAUDE_ARGS）を先に置いて、そのあとに渡された引数を続ける。
VM_PRELUDE='
S="/Volumes/My Shared Files/shared"
[ -f "$S/env.sh" ] || { echo "mise run start が動いていません（共有フォルダがありません）" >&2; exit 1; }
. "$S/env.sh"
'

# 引数なし: ~/work（全部のリポジトリが並ぶところ）で新しい会話を始める。
HERE_SCRIPT="$VM_PRELUDE"'
cd ~/work || exit 1
eval "set -- $(cat "$S/claude-args") \"\$@\""
exec claude "$@"
'

# $1 は会話の ID（ホストで形を絞ってある）。会話が始まったフォルダに移って再開する。
RESUME_SCRIPT="$VM_PRELUDE"'
ID=$1; shift
F=$(ls ~/.claude/projects/*/"$ID".jsonl 2>/dev/null | head -1)
[ -n "$F" ] || { echo "会話が見つかりません: $ID" >&2; exit 1; }
DIR=$(python3 -c "
import json, sys
for line in open(sys.argv[1], encoding=\"utf-8\"):
    try: d = json.loads(line)
    except ValueError: continue
    if d.get(\"cwd\"): print(d[\"cwd\"]); break" "$F")
[ -d "$DIR" ] || { echo "会話のフォルダがありません: $DIR" >&2; exit 1; }
cd "$DIR" || exit 1
eval "set -- $(cat "$S/claude-args") --resume \"\$ID\" \"\$@\""
exec claude "$@"
'

# $1 は REPOS の名前（ホストで REPOS から引いてある）。~/work/<名前> の履歴から作業ツリーを切る。
# ~/work/sessions/<日時>/<名前> に、デフォルトブランチから切った agent/<日時> で作る。ほかの会話と混ざらない。
NEW_SCRIPT="$VM_PRELUDE"'
n=$1; shift
BASE="$HOME/work/$n"
[ -d "$BASE/.git" ] || { echo "$BASE がありません（mise run start をやり直してください）" >&2; exit 1; }
git -C "$BASE" fetch --prune origin >&2 || exit 1
git -C "$BASE" remote set-head origin -a >/dev/null 2>&1 || true
HEADREF=$(git -C "$BASE" symbolic-ref --short refs/remotes/origin/HEAD) || { echo "デフォルトブランチを引けません" >&2; exit 1; }
STAMP=$(date +%Y%m%d-%H%M%S)
W="$HOME/work/sessions/$STAMP/$n"
mkdir -p "$(dirname "$W")"
git -C "$BASE" worktree add -b "agent/$STAMP" "$W" "$HEADREF" >&2 || exit 1
# Git 管理外のビルド用ファイルは、元の clone から持ってくる
for f in local.properties secret.properties; do
  [ -f "$BASE/$f" ] && cp "$BASE/$f" "$W/$f"
done
# Pods は、同じ Podfile.lock で入れ済みなら APFS の複製で持ってくる
if [ -f "$W/Podfile.lock" ] && [ -d "$BASE/Pods" ] && cmp -s "$BASE/Pods/Manifest.lock" "$W/Podfile.lock"; then
  cp -cR "$BASE/Pods" "$W/Pods"
fi
if [ -f "$W/.gitmodules" ] && [ -n "${GH_TOKEN_RO:-}" ]; then
  git -C "$W" -c "url.https://x-access-token:$GH_TOKEN_RO@github.com/.insteadOf=git@github.com:" \
    submodule update --init --depth 1 >&2 || echo "warning: submodule を取れませんでした" >&2
fi
echo "作業ツリー: ${W}（ブランチ agent/${STAMP}）" >&2
cd "$W" || exit 1
eval "set -- $(cat "$S/claude-args") \"\$@\""
exec claude "$@"
'

[ "$(vm_state "$VM")" = running ] || die "VM '$VM' が動いていません（mise run start）"

if [ -n "$ID" ]; then
  printf '%s' "$ID" | grep -Eqx '[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}' ||
    die "会話の ID の形が違います。claude を抜けるときに出る claude --resume の後ろの文字列です"
  exec tart exec -i -t "$VM" /bin/bash -lc "$RESUME_SCRIPT" _ "$ID" ${PASS[@]+"${PASS[@]}"}
fi

if [ -n "$NAME" ]; then
  # 名前は REPOS から引く。VM へは、そこにある名前だけを渡す。
  FOUND=""
  CHOICES=""
  for r in ${REPOS[@]+"${REPOS[@]}"}; do
    [ -n "$r" ] || continue
    [ "${r##*/}" != "$NAME" ] || FOUND=${r##*/}
    CHOICES="${CHOICES:+$CHOICES / }${r##*/}"
  done
  [ -n "$FOUND" ] || die "REPOS に '${NAME}' がありません。あるのは: ${CHOICES}"
  exec tart exec -i -t "$VM" /bin/bash -lc "$NEW_SCRIPT" _ "$FOUND" ${PASS[@]+"${PASS[@]}"}
fi

exec tart exec -i -t "$VM" /bin/bash -lc "$HERE_SCRIPT" _ ${PASS[@]+"${PASS[@]}"}
