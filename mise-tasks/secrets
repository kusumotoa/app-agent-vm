#!/bin/bash
#MISE description="シークレットをキーチェーンに登録する（ターミナルで直接実行する）"
set -euo pipefail

ROOT="${MISE_PROJECT_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}"
# shellcheck source=config.sh
. "$ROOT/config.sh"
# shellcheck source=lib/secrets.sh
. "$ROOT/lib/secrets.sh"

ask() {
  local name=$1 label=$2 hidden=$3 value
  if [ "$hidden" = yes ]; then
    read -rsp "$label: " value; echo
  else
    read -rp "$label: " value
  fi
  [ -n "$value" ] || { echo "空なので $name は変更しません"; return 0; }
  write_secret "$name" "$value" || { echo "  キーチェーンに書けません" >&2; return 1; }
  echo "  → キーチェーン（${AAV_KEYCHAIN_SERVICE} / ${name}）"
}

if [ ! -t 0 ]; then
  cat >&2 <<EOS
入力を受け取れません。ターミナルで直接実行してください。
パイプや別プロセス経由では読めません。

キーチェーンに直接書くなら:

  # クリップボード経由にすると、履歴にも画面にも残りません
  put() { security add-generic-password -U -s ${AAV_KEYCHAIN_SERVICE} -a "\$1" -w "\$2"; }

  put github-token      "\$(pbpaste | tr -d '
')"
  put github-token-ro   "\$(pbpaste | tr -d '
')"

EOS
  exit 2
fi

echo "空のまま Enter を押すと変更しません"
echo
cat <<EOS
Claude の OAuth トークンを聞きます（任意）。
ホストで claude setup-token を実行して出たものです。
入れなければ、VM の中で claude が出す手順でログインします。

EOS
ask claude-token "Claude の OAuth トークン" yes
echo

cat <<EOS
GitHub の PAT を 2 つ聞きます。用途が違うので使い回さないでください。
権限は docs/instructions/secrets.md の表のとおりに付けます。
  書き込み用   ${REPOS[*]:-（config.sh の REPOS）}
  読み取り用   ${REFS[*]:-（config.sh の REFS。空なら不要）}
  作る場所     https://github.com/settings/personal-access-tokens/new

EOS
ask github-token    "書き込み用の PAT" yes
ask github-token-ro "読み取り用の PAT" yes

cat <<EOS

ビルドが GitHub Packages から取るなら、その PAT を入れます（使わなければ空のまま Enter）。
classic で read:packages だけ。作る場所  https://github.com/settings/tokens/new
EOS
ask github-packages-token "GitHub Packages の PAT" yes

echo
echo "登録済み:"
for name in claude-token github-token github-token-ro github-packages-token; do
  if security find-generic-password -s "$AAV_KEYCHAIN_SERVICE" -a "$name" >/dev/null 2>&1; then
    printf '  %s\n' "$name"
  fi
done
